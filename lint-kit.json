{
  "profile": "adopt",
  "languages": ["ts", "py"],
  "ignore": ["node_modules/**", "dist/**", ".git/**", "coverage/**", "quartz/**"],
  "proseGlobs": [
    "README.md",
    "**/README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/**/*.md",
    "content/index.md",
    "content/zh-Hant/index.md"
  ],
  "boundaryFiles": [],
  "baseline": ".lint-kit-baseline.json",
  "batch": "v2",
  "rules": {
    "R10": "error",
    "R5": "error",
    "R8": "error",
    "R23": "error",
    "R16": "error",
    "R2": "error",
    "R21": "error"
  },
  "prose": {
    "allow": []
  }
}
